{
 "scopeName": "vim.injection.c-comment-line",
 "injectionSelector": "L:comment.line.double-slash.c -vim.String",
 "patterns": [
  {
   "begin": "(?<!\\\\)L?\"",
   "end": "\"|$",
   "name": "vim.String.cComment2String",
   "patterns": [
    {
     "match": "\\\\(?:x[0-9a-fA-F]+|[0-7]{1,3}|.|$)",
     "name": "vim.Special.cSpecial"
    }
   ]
  },
  {
   "match": "L?'[^\\\\']'|L'[^']*'",
   "name": "vim.Character.cCharacter"
  },
  {
   "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F]+(?:'[0-9a-fA-F]+)*(?:[uU]?[lL]{0,2}|[lL]{1,2}[uU])|0[bB][01]+(?:'[01]+)*(?:[uU]?[lL]{0,2}|[lL]{1,2}[uU])|\\d+(?:'\\d+)*(?:[uU]?[lL]{0,2}|[lL]{1,2}[uU]))(?![\\w.])",
   "name": "vim.Number.cNumber"
  },
  {
   "match": "(?<![\\w.])(?:\\d+[fF]|\\d+\\.\\d*(?:[eE][-+]?\\d+)?[fFlL]?|\\d+[eE][-+]?\\d+[fFlL]?)(?![\\w.])|(?<![\\w])\\.\\d+(?:[eE][-+]?\\d+)?[fFlL]?(?![\\w.])",
   "name": "vim.Float.cFloat"
  }
 ]
}