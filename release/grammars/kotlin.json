{
 "scopeName": "vim.injection.kotlin",
 "injectionSelector": "L:source.kotlin -comment -string",
 "patterns": [
  {
   "match": "\\b(?:false|true)\\b",
   "name": "vim.Boolean.ktBoolean"
  },
  {
   "match": "\\b(?:else|when|if)\\b",
   "name": "vim.Conditional.ktConditional"
  },
  {
   "match": "\\b(?:null)\\b",
   "name": "vim.Constant.ktConstant"
  },
  {
   "match": "\\b(?:typeof)\\b",
   "name": "vim.Error.ktReservedKeyword"
  },
  {
   "match": "\\b(?:finally|catch|throw|try)\\b",
   "name": "vim.Exception.ktException"
  },
  {
   "match": "\\b(?:package|import)\\b",
   "name": "vim.Include.ktInclude"
  },
  {
   "match": "\\b(?:super|where|this|get|out|set)\\b",
   "name": "vim.Keyword.ktKeyword"
  },
  {
   "match": "\\b(?:by|in|is)\\b",
   "name": "vim.Operator.ktOperator"
  },
  {
   "match": "\\b(?:while|for|do)\\b",
   "name": "vim.Repeat.ktRepeat"
  },
  {
   "match": "\\b(?:continue|return|break)\\b",
   "name": "vim.Statement.ktStatement"
  },
  {
   "match": "\\b(?:crossinline|annotation|companion|abstract|external|noinline|override|dynamic|reified|suspend|actual|expect|inline|sealed|vararg|final|inner|enum|open)\\b",
   "name": "vim.StorageClass.ktModifier"
  },
  {
   "match": "\\b(?:constructor|interface|typealias|object|class|init|fun|val|var)\\b",
   "name": "vim.Structure.ktStructure"
  },
